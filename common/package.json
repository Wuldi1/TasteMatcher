{
  "name": "@tastematcher/common",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "npm run clean && tsc -p tsconfig.json --listEmittedFiles",
    "watch": "tsc -w",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.0",
    "@azure/storage-blob": "^12.29.1",
    "@azure/storage-queue": "^12.28.1",
    "@nestjs/common": "^11.1.8",
    "jimp": "^0.22.12",
    "p-retry": "^7.1.0",
    "pino-pretty": "^13.1.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.38.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "files": [
    "build/**/*",
    "src/**/*"
  ]
}
