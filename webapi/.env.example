# Local Web API example (no production credentials)
NODE_ENV=development
PORT=8080
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
BACKEND_API_URL="http://localhost:8080"
FRONTEND_URL="http://localhost:3000"

# Use these only through the guarded local-production sync script.
TASTEMATCHER_RUNTIME_MODE=
TASTEMATCHER_DATA_ENV=
TASTEMATCHER_LOCAL_PROD_ACK=
TASTEMATCHER_EMAIL_MODE=disabled

# Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
AzureWebJobsStorage=
IMAGE_PROCESSING_QUEUE_NAME=
NEW_ARTWORK_QUEUE_NAME=

# Azure AI
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_KEY=

# Cosmos DB
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=

# Local-production sync changes delivery to verification-only.
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=

# Authentication
JWT_SECRET=
