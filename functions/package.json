{
  "name": "@tastematcher/functions",
  "version": "1.0.0",
  "description": "Azure Functions for TasteMatcher image processing",
  "main": "dist/src/ProcessImagesFromBlob/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && func start"
  },
  "dependencies": {
    "@azure/functions": "^4.8.0",
    "@azure/storage-blob": "^12.29.1",
    "@azure/storage-queue": "^12.23.0",
    "@azure/search-documents": "^12.2.0",
    "@azure-rest/ai-vision-image-analysis": "^1.0.0-beta.3",
    "@azure/core-auth": "^1.9.0",
    "@tastematcher/common": "workspace:*",
    "sharp": "^0.33.5",
    "pino": "^10.1.0",
    "pino-pretty": "^12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "azure-functions-core-tools": "^4.0.6280",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
