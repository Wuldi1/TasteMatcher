{
  "name": "@tastematcher/functions",
  "version": "1.0.0",
  "description": "Azure Functions for TasteMatcher image processing",
  "main": "build/index.js",
  "scripts": {
    "build": "rimraf build && tsc && cp host.json build/",
    "watch": "tsc --watch",
    "clean": "rimraf build",
    "prestart": "pnpm build",
    "start": "node -e \"console.error('Functions are not started by default. Use the documented start:local-production command with exactly one trigger.'); process.exit(1)\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "start:local-production": "pnpm build && node scripts/start-local-production.mjs",
    "copy-files": "cp host.json build/"
  },
  "dependencies": {
    "@azure-rest/ai-vision-image-analysis": "^1.0.0-beta.3",
    "@azure/communication-email": "^1.1.0",
    "@azure/core-auth": "^1.9.0",
    "@azure/cosmos": "^4.9.0",
    "@azure/functions": "^4.8.0",
    "@azure/storage-blob": "^12.29.1",
    "@azure/storage-queue": "^12.28.1",
    "@nestjs/common": "^11.1.8",
    "@tastematcher/common": "workspace:*",
    "jimp": "^0.22.12",
    "p-retry": "^7.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.38.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
