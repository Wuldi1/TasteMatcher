{
  "name": "tastematcher",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build:common": "pnpm --filter @tastematcher/common build",
    "build:webapi": "pnpm --filter @tastematcher/common build && pnpm --filter @tastematcher/webapi build && cp ./webapi/package.json ./webapi/build/package.json && cp ./webapi/.env.dev ./webapi/build/.env.dev",
    "build:frontend": "pnpm --filter @tastematcher/common build && pnpm --filter @tastematcher/frontend build",
    "build:functions": "pnpm --filter @tastematcher/common build && pnpm --filter @tastematcher/functions build",
    "start:local:webapi": "pnpm run build:webapi && pnpm --filter @tastematcher/webapi start:local",
    "start:dev:webapi": "pnpm --filter @tastematcher/webapi start:dev",
    "start:prd:webapi": "pnpm --filter @tastematcher/webapi start:prd",
    "start:frontend": "pnpm run build:frontend && pnpm --filter @tastematcher/frontend start"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.26",
    "baseline-browser-mapping": "^2.9.15",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pnpm": "^10.20.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@azure/functions": "^4.8.0",
    "@azure/search-documents": "^12.2.0",
    "@azure/storage-blob": "^12.29.1",
    "functions": "^1.0.9",
    "path": "^0.12.7",
    "pino": "^10.1.0",
    "react-easy-crop": "^5.5.6"
  }
}
